{
  "name": "xml-to-json-converter",
  "version": "1.1.0",
  "description": "Конвертер XML в JSON с использованием XSLT и XSD валидацией",
  "main": "src/index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "build": "pkg . --out-path dist/"
  },
  "pkg": {
    "targets": [
      "node16-win-x64",
      "node16-linux-x64",
      "node16-macos-x64"
    ]
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "xmldom": "^0.6.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "xml",
    "xsd",
    "converter",
    "validation"
  ],
  "author": "Your Name",
  "license": "MIT"
}
